# Database Configuration for MySQL
# Copy to .env and fill in. NEVER commit .env

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=employee_dw

# Hosted DBs (Aiven etc.) usually need SSL. Use false for local MySQL.
DB_SSL=false
# Optional CA certificate path (the CA cert is public, it may live in certs/ca.pem)
DB_SSL_CA=

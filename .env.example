# Copy to .env and fill in. NEVER commit .env
# Copy .env.example to .env and set DB_HOST=localhost, DB_USER=root, DB_PASSWORD=<yours>, DB_NAME=employee_dw, DB_SSL=false

DB_HOST=your-host.aivencloud.com 
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=bhavesh09
DB_NAME=defaultdb
# Hosted DBs (Aiven etc.) usually need SSL. Use false for local MySQL.
DB_SSL=true
# Optional CA certificate path (the CA cert is public, it may live in certs/ca.pem)
DB_SSL_CA=